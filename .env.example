APP_NAME=CMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8011
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms_workspace
DB_USERNAME=root
DB_PASSWORD=
DB_URL=
CMS_DB_PROFILE=cms
CMS_DB_DATABASE=cms_workspace
SESSION_DRIVER=file
SESSION_COOKIE=cms_workspace_session
SESSION_DOMAIN=null
SESSION_LIFETIME=120
CACHE_STORE=file
CACHE_PREFIX=cms_workspace_
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
BROADCAST_CONNECTION=log
VITE_THEME_PATH=resources/themes
VITE_THEME_NAME=materialize
CMS_ROUTE_PREFIX=cms
CMS_SHARE_SOURCE_MEDIA=false
CMS_REGISTER_MIGRATIONS=false
CMS_UNIT_KEY=nam-binh-duong
CMS_UNIT_NAME="Nam Bình Dương"
CMS_UNIT_TYPE=education

# Project of this deployment (nam-binh-duong | ban-de-an | khuyen-nong). Production: set it, the project and its public theme are then fixed.
# Leave empty on a local all-themes install: the project follows the public theme chosen in the administration.
CMS_PROJECT_KEY=

# Facebook / Meta App (Truyen thong da kenh). Leave empty to keep Facebook disabled. Never commit real values.
# META_REDIRECT_URI must equal the callback registered at Meta: {APP_URL}/cms/truyen-thong/tai-khoan/facebook/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_REDIRECT_URI=

# Developer Settings: one variable. Empty or missing = Developer Settings is off (404). To turn it on, hash a Developer password:
#   php artisan tinker --execute="echo Hash::make('your-password');"
# and paste the result in single quotes (the hash contains "$"). Never put the password itself here.
DEVELOPER_ACCESS_TOKEN_HASH=
